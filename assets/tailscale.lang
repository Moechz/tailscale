[zh-cn]
name         = "Tailscale"
auth         = "Tailscale Inc."
version      = "@@VERSION@@"
descript     = "Tailscale 基于 WireGuard 把您的设备组成一个私有网络：无论 NAS 在家还是在公网，都能用固定的 100.x 地址安全访问，无需公网 IP、无需端口映射。本应用内置官方 tailscaled 守护进程与控制台，开机自启；控制台通过 TOS 网页（8181 端口的 /tailscale/ 路径）打开，不额外暴露端口。安装后点击图标即可登录账号（支持 Google/Microsoft/GitHub 等），在管理后台授权本设备后即可使用。"
release_note = "首次发布：内置 Tailscale 1.104.5 官方静态二进制，支持 x86_64 与 aarch64 两种架构；提供与上游一致的 Web 控制台，可查看连接状态、登录/登出、启用 SSH、设置子网路由与出口节点。"
important    = "节点身份保存在 /var/lib/tailscale：apt remove 保留（重装免重新登录），apt purge 才会删除。卸载或更换账号前请先在控制台登出，否则管理后台会残留旧设备记录。本应用仅监听回环地址，对外通信使用 UDP 41641。"

[zh-hk]
name         = "Tailscale"
auth         = "Tailscale Inc."
version      = "@@VERSION@@"
descript     = "Tailscale 基於 WireGuard 將您的裝置組成一個私有網絡：無論 NAS 在家居網絡還是公網，都可以用固定的 100.x 位址安全存取，毋須公網 IP、毋須端口映射。本應用內置官方 tailscaled 守護進程與控制台，開機自動啟動；控制台經 TOS 網頁（8181 端口的 /tailscale/ 路徑）開啟，不額外暴露端口。"
release_note = "首次發佈：內置 Tailscale 1.104.5 官方靜態二進制，支援 x86_64 與 aarch64；提供與上游一致的 Web 控制台。"
important    = "節點身份保存在 /var/lib/tailscale：apt remove 會保留（重裝免重新登入），apt purge 才會刪除。本應用僅監聽回環位址，對外通訊使用 UDP 41641。"

[en-us]
name         = "Tailscale"
auth         = "Tailscale Inc."
version      = "@@VERSION@@"
descript     = "Tailscale builds a private mesh network between your devices over WireGuard: reach this NAS from anywhere through a stable 100.x address, with no public IP and no port forwarding. This package bundles the official tailscaled daemon and the upstream web console as a dedicated, unprivileged service that starts with the system. The console is served through the TOS web UI at /tailscale/ (port 8181) and exposes no extra port. Click the desktop icon, sign in with your identity provider, and approve the device in the admin console."
release_note = "First release: bundles the official Tailscale 1.104.5 static binaries for x86_64 and aarch64, with the upstream web console for status, login/logout, Tailscale SSH, subnet routes and exit nodes."
important    = "Node identity and login state live in /var/lib/tailscale: 'apt remove' keeps them (reinstall keeps you signed in), 'apt purge' deletes them. Sign out from the console before switching accounts, otherwise the old device entry stays in the admin console. The app listens on loopback only; peer traffic uses UDP 41641."

[fr-fr]
