#!/bin/bash
# postinst —— 幂等；**任何失败都不让 dpkg 返回非 0**（D-020）。
# 评审环境（不同 TOS 构建/内核/组件）不可控：安装必须先成功，
# 运行期问题记日志并尽量降级，再由应用中心做启动检查。
set -u

APPID="tailscale"
UNIT="tailscale"
WEB_UNIT="tailscale-web"
APPDIR="/usr/local/${APPID}"
LOG="/var/log/${APPID}-maint.log"

mkdir -p /var/log 2>/dev/null || true
touch "$LOG" 2>/dev/null || true
log()  { printf '%s\n' "$*" 2>/dev/null | tee -a "$LOG" 2>/dev/null || printf '%s\n' "$*"; }
warn() { printf '警告: %s\n' "$*" 2>/dev/null | tee -a "$LOG" 2>/dev/null || true; }
t() { local s=$1; shift; if command -v timeout >/dev/null 2>&1; then timeout "$s" "$@"; else "$@"; fi; }

log "=== postinst $1 $(date -Is) ==="

# 1) 用户兜底（preinst 已建；平台也可能已建）
if ! getent passwd "$APPID" >/dev/null 2>&1; then
  getent group "$APPID" >/dev/null 2>&1 || t 10 groupadd --system "$APPID" 2>>"$LOG" || true
  t 10 useradd --system --no-create-home --shell /usr/sbin/nologin "$APPID" 2>>"$LOG" \
    || warn "无法补建系统用户 $APPID（服务可能无法启动）"
fi

# 2) 应用目录属主
[ -d "$APPDIR" ] && { chown -R "${APPID}:${APPID}" "$APPDIR" 2>>"$LOG" || warn "chown 应用目录失败"; }

# 3) /dev/net/tun（缺失时创建；失败不阻断）
if [ ! -c /dev/net/tun ]; then
  if mkdir -p /dev/net 2>>"$LOG" && mknod /dev/net/tun c 10 200 2>>"$LOG"; then
    chmod 666 /dev/net/tun 2>/dev/null || true
    log "已创建 /dev/net/tun"
  else
    warn "/dev/net/tun 创建失败；请确认内核加载了 tun 模块"
  fi
fi

# 4) 解压 webui.bz2（两种解压方式，失败只告警）
if [ -f "$APPDIR/webui.bz2" ]; then
  rm -rf "$APPDIR/webui" 2>/dev/null || true
  mkdir -p "$APPDIR/webui" 2>/dev/null || true
  if tar xjf "$APPDIR/webui.bz2" -C "$APPDIR/webui" 2>>"$LOG" \
     || python3 - "$APPDIR/webui.bz2" "$APPDIR/webui" 2>>"$LOG" <<'PY'
import bz2, sys, tarfile, io
data = bz2.decompress(open(sys.argv[1], 'rb').read())
with tarfile.open(fileobj=io.BytesIO(data)) as tf:
    tf.extractall(sys.argv[2])
PY
  then
    chmod -R a+rX "$APPDIR/webui" 2>/dev/null || true
    chown -R "${APPID}:${APPID}" "$APPDIR/webui" 2>/dev/null || true
    log "webui 已解压到 $APPDIR/webui"
  else
    warn "webui.bz2 解压失败（不影响 tailscaled）"
  fi
fi

# 5) 配置模板首装复制，升级不覆盖
if [ ! -e "$APPDIR/${APPID}.env" ] && [ -f "$APPDIR/${APPID}.env.example" ]; then
  if cp "$APPDIR/${APPID}.env.example" "$APPDIR/${APPID}.env" 2>>"$LOG"; then
    chown "${APPID}:${APPID}" "$APPDIR/${APPID}.env" 2>/dev/null || true
    chmod 0640 "$APPDIR/${APPID}.env" 2>/dev/null || true
    log "已生成 $APPDIR/${APPID}.env（首装默认值）"
  else
    warn "无法生成 ${APPID}.env"
  fi
fi

# 6) 上游同名单元若存在，停用避免双实例（失败只告警）
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files tailscaled.service 2>/dev/null | grep -q '^tailscaled\.service'; then
  warn "检测到上游 tailscaled.service，停止并禁用"
  t 20 systemctl disable --now tailscaled.service 2>>"$LOG" || true
fi

# 7) systemd 重载 + enable（失败只告警）
if command -v systemctl >/dev/null 2>&1; then
  t 20 systemctl daemon-reload 2>>"$LOG" || warn "systemctl daemon-reload 失败"
  t 20 systemctl enable "$UNIT" >/dev/null 2>&1 || warn "enable $UNIT 失败"
  t 20 systemctl enable "$WEB_UNIT" >/dev/null 2>&1 || warn "enable $WEB_UNIT 失败"
else
  warn "未找到 systemctl（非 systemd 环境？）"
fi

# 8) nginx 校验（失败回滚本包配置，避免拖垮整站）
NGINX_CONF="/etc/nginx/conf.d/${APPID}.conf"
if command -v nginx >/dev/null 2>&1; then
  if ! t 15 nginx -t 2>>"$LOG"; then
    warn "nginx -t 失败；临时禁用 $NGINX_CONF"
    mv -f "$NGINX_CONF" "${NGINX_CONF}.disabled" 2>/dev/null || true
    if t 15 nginx -t 2>>"$LOG"; then
      log "已回滚本项目 nginx 配置，其余路由不受影响"
    else
      warn "nginx 配置本身有问题（非本包引起），请检查 /etc/nginx"
    fi
  fi
  t 20 systemctl reload nginx 2>>"$LOG" || t 20 systemctl restart nginx 2>>"$LOG" || warn "nginx reload 失败"
fi

# 9) 启动（升级路径同样 restart）
main_rc=0; web_rc=0
if command -v systemctl >/dev/null 2>&1; then
  t 40 systemctl restart "$UNIT" || main_rc=$?
  t 25 systemctl restart "$WEB_UNIT" || web_rc=$?
fi
[ $main_rc -ne 0 ] && warn "tailscaled 启动失败（rc=$main_rc），排查: journalctl -u ${UNIT} -n 50 --no-pager"
[ $web_rc  -ne 0 ] && warn "tailscale web 启动失败（rc=$web_rc），排查: journalctl -u ${WEB_UNIT} -n 50 --no-pager"

# 9b) 首装默认值：关闭 MagicDNS（CorpDNS），只做一次
if [ ! -e "/var/lib/${APPID}/.defaults-applied" ] && [ -x "$APPDIR/bin/tailscale" ]; then
  dns_rc=1
  if command -v runuser >/dev/null 2>&1; then
    t 8 runuser -u "$APPID" -- "$APPDIR/bin/tailscale" set --accept-dns=false >>"$LOG" 2>&1 && dns_rc=0
  elif command -v su >/dev/null 2>&1; then
    t 8 su -s /bin/sh "$APPID" -c "$APPDIR/bin/tailscale set --accept-dns=false" >>"$LOG" 2>&1 && dns_rc=0
  fi
  if [ $dns_rc -eq 0 ]; then
    mkdir -p "/var/lib/${APPID}" 2>/dev/null || true
    touch "/var/lib/${APPID}/.defaults-applied" 2>/dev/null || true
    log "已应用首装默认值：MagicDNS 关闭"
  else
    warn "应用首装默认值失败（不影响隧道功能）"
  fi
fi

# 10) 就绪检查：控制台回环可达（最多 10s，避免拖住安装）
ready=0
if command -v curl >/dev/null 2>&1; then
  for _ in $(seq 1 10); do
    if curl -fsS -o /dev/null --max-time 1 "http://127.0.0.1:8088/" 2>/dev/null; then ready=1; break; fi
    sleep 1
  done
fi
if [ $ready -eq 1 ]; then
  log "控制台就绪: http://127.0.0.1:8088/"
else
  warn "控制台 10s 内未就绪；排查: journalctl -u ${UNIT} -n 50 --no-pager"
fi

log "安装完成。打开方式: http://<NAS 的 IP>:8181/${APPID}/"
exit 0
