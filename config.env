# ============================================================
# config.env —— 单一事实源（版本 / 端口 / 校验值 / 署名）
# 改版本只改这里；build.sh 全部由此派生
# ============================================================

# ---- 应用标识（上架后不可再改：牵动 10 处）----
APP_ID="tailscale"
APP_NAME="Tailscale"
PUBLISHER="Moechz"
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
UPSTREAM_AUTHOR="Tailscale Inc."

# ---- 版本：<上游版本>-<打包迭代号>（迭代号永不零填充，严格递增）----
TS_VERSION="1.104.5"
PKG_RELEASE="4"

# ---- 端口（应用只监听回环，由平台 nginx 反代到 /tailscale/）----
# Web 控制台（tailscale web）：上游默认 8088，落在官方推荐段 8000-19999
WEB_PORT="8088"
# tailscaled 的 WireGuard/ disco UDP 端口：固定值便于用户做端口映射
TS_UDP_PORT="41641"

# ---- 上游静态包（pkgs.tailscale.com/stable）----
# 注意：Tailscale 的 GitHub Release 不带二进制资产，官方分发只走 pkgs.tailscale.com
UPSTREAM_BASE="https://pkgs.tailscale.com/stable"
SHA256_TARBALL_AMD64="720cbbccbfc03d8b55df72afc19e5a72e31b0f65934700aa6fa38074d4ad7bf7"
SHA256_TARBALL_ARM64="e900b0e6e25023a1e504b2c237ce2a32ea0535e006f8c1a1097a490886493b6c"
UPSTREAM_REPO="https://github.com/tailscale/tailscale"
# 上游 wiki 实际有内容（Home · tailscale/tailscale Wiki），official 指它
OFFICIAL_URL="https://github.com/tailscale/tailscale/wiki"
UPSTREAM_LICENSE="BSD-3-Clause"

# ---- 自建仓库（公开，商店校验器要匿名拉 Release 资产）----
GITHUB_REPO="Moechz/tailscale"

# ---- 默认目标架构：amd64 / arm64 ----
TARGET_ARCH="${TARGET_ARCH:-amd64}"
